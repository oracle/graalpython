--- a/pip/_vendor/packaging/tags.py
+++ b/pip/_vendor/packaging/tags.py
@@ -842,6 +842,27 @@ def _version_nodot(version: PythonVersion) -> str:
     return "".join(map(str, version))
 
 
+def _graalpy_abi3t_tags(
+    python_version: PythonVersion | None = None,
+    platforms: Iterable[str] | None = None,
+) -> Iterator[Tag]:
+    try:
+        import __graalpython__
+    except ImportError:
+        return
+    if not getattr(__graalpython__, "abi3t_enabled", False):
+        return
+    if python_version is None:
+        python_version = sys.version_info[:2]
+    if len(python_version) < 2 or tuple(python_version) < (3, 2):
+        return
+    platforms = list(platforms or platform_tags())
+    for minor_version in range(python_version[1], 1, -1):
+        interpreter = f"cp{_version_nodot((python_version[0], minor_version))}"
+        for platform_ in platforms:
+            yield Tag(interpreter, "abi3t", platform_)
+
+
 def sys_tags(*, warn: bool = False) -> Iterator[Tag]:
