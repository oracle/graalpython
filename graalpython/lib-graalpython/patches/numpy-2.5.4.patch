+++ b/numpy/_core/include/numpy/ndarrayobject.h
@@ -211,6 +211,12 @@ NPY_TITLE_KEY_check(PyObject *key, PyObject *value)
     if (key == title) {
         return 1;
     }
+#ifdef GRAALVM_PYTHON
+    /* GraalPy dictionary keys do not always preserve object identity. */
